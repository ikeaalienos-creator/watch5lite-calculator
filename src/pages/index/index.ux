    <div class="row">
      <button class="btn" value="0" onclick="press"></button>
      <button class="btn" value="C" onclick="clear"></button>
      <button class="btn" value="=" onclick="calculate"></button>
      <button class="btn" value="+" onclick="press"></button>
    </div>
  </div>
</template>

<script>
export default {
  data: {
    display: "0"
  },

  press(value) {
    this.display = value
  },

  clear() {
    this.display = "0"
  },

  calculate() {
    this.display = "0"
  }
}
</script>

