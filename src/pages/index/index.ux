<template>
  <div class="container">
    <text class="title">Kalkulator</text>
    <text class="result">0</text>

    <div class="row">
      <button class="btn" value="7" onclick="press"></button>
      <button class="btn" value="8" onclick="press"></button>
      <button class="btn" value="9" onclick="press"></button>
      <button class="btn" value="÷" onclick="press"></button>
    </div>

    <div class="row">
      <button class="btn" value="4" onclick="press"></button>
      <button class="btn" value="5" onclick="press"></button>
      <button class="btn" value="6" onclick="press"></button>
      <button class="btn" value="×" onclick="press"></button>
    </div>

    <div class="row">
      <button class="btn" value="1" onclick="press"></button>
